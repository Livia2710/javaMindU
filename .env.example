# Senha inicial do administrador criado no perfil local (preencha antes de subir a API).
MINDU_ADMIN_SENHA=

# Integração opcional com a Mila.
MILA_API_KEY=
GROQ_API_KEY=
MILA_BUILD_CONTEXT=./mila
MILA_ENV_FILE=./mila.env

# Origens de navegador permitidas localmente. Separe múltiplas URLs por vírgula.
CORS_ORIGENS=http://localhost:5173,http://localhost:3000,https://mind-u-pi.vercel.app

# Padrão: 10 logins por minuto por IP.
MINDU_LOGIN_LIMITE_POR_MINUTO=10

# SMTP transacional (preencha com as credenciais SMTP da Brevo no .env local).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# URL da tela do front que lê ?token=... para concluir a redefinição.
MINDU_RESET_PASSWORD_URL=http://localhost:5173/redefinir-senha
